# Copy this file to .env and fill in real values. Deploy steps: docs/deployment.md
#
# .env is gitignored — never commit real secrets.

# A strong, unique password for the production Postgres user.
# Do not reuse the local dev password.
POSTGRES_PASSWORD=change-me

# Anthropic API key used by the Ask Firesight feature (from the Anthropic Console).
CLAUDE_API_KEY=sk-ant-...
