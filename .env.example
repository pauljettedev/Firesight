# Copy this file to .env and fill in real values, then run:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# .env is gitignored — never commit real secrets.

# The domain Caddy requests a Let's Encrypt certificate for. Must already have
# a DNS A record pointing at this server.
DOMAIN=example.com

# A strong, unique password for the production Postgres user.
# Do not reuse the local dev password.
POSTGRES_PASSWORD=change-me

# Anthropic API key used by the Ask Firesight feature (from the Anthropic Console).
CLAUDE_API_KEY=sk-ant-...
