{$DOMAIN} {
	reverse_proxy app:8080
}

# Caddy only gets HTTPS certificates for sites listed here, so www needs its
# own block even though DNS already points it at this server. It gets a
# certificate too, then permanently redirects to the main domain so there's
# one canonical address.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
