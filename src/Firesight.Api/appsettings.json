{
  "Cwfis": {
    "BaseUrl": "https://geoserver.cwfif.nrcan.gc.ca/geoserver/ows",
    "ActiveFiresLayer": "public:cwfif_national_activefires",
    "PageSize": 1000
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org/"
  },
  "OpenAI": {
    "Model": "gpt-5-mini"
  },
  "WildfireRetention": {
    "ExtinguishedDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WildfireFreshness": {
    "StaleAfterHours": 48
  }
}
