{
  "Cwfis": {
    "BaseUrl": "https://geoserver.cwfif.nrcan.gc.ca/geoserver/ows",
    "ActiveFiresLayer": "public:cwfif_national_activefires",
    "PageSize": 1000
  },
  "WildfireRetention": {
    "ExtinguishedDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WildfireFreshness": {
    "StaleAfterHours": 48
  }
}
